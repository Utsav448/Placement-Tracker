# Copy this file to .env and fill in your real values before running

PORT=5000

# MySQL connection (use your local MySQL, or a free hosted MySQL like Railway/Aiven/Clever Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=placement_tracker

# Any long random string - used to sign login tokens (JWT)
JWT_SECRET=change_this_to_a_long_random_string
